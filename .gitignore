# ============================================================
# Bluestock Mutual Fund Analytics — .gitignore
# ============================================================

# ------------------------------
# Python bytecode / cache
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ------------------------------
# Virtual Environments
# ------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ------------------------------
# Database files (keep schema.sql, ignore *.db)
# ------------------------------
*.db
*.sqlite
*.sqlite3
data/db/

# ------------------------------
# Testing & Coverage
# ------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
nosetests.xml
coverage.xml
*.cover

# ------------------------------
# Distribution / Packaging
# ------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------
# Jupyter Notebook checkpoints
# ------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ------------------------------
# Logs & temporary files
# ------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------
# OS generated files
# ------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------
# Node / JavaScript
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/

# ------------------------------
# IDE / Editor settings
# ------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------
# PyInstaller
# ------------------------------
*.manifest
*.spec

# ------------------------------
# Lock files (optional — keep these if using pip-tools)
# ------------------------------
# poetry.lock
# Pipfile.lock

# ------------------------------
# Environment variable files
# ------------------------------
.env
.env.local
.env.*.local

# ------------------------------
# C extensions
# ------------------------------
*.so

# ------------------------------
# Dataset archives (large binary files — not committed)
# ------------------------------
*.zip
*.zip.zip
*.tar.gz
*.rar
